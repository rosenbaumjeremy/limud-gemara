# Cloudflare reads this file. These headers limit what a page can do once
# served, and keep the site out of search results. The Gemara text and
# commentaries are read from Sefaria's public API.

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://manuscripts.sefaria.org; connect-src 'self' https://www.sefaria.org; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

/data/*
  Cache-Control: no-cache

# the offline copy's service worker: always check for a newer one
/sw.js
  Cache-Control: no-cache
